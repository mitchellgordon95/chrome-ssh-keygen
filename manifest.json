{
  "manifest_version": 3,
  "name": "SSH Key Generator",
  "version": "2.0.0",
  "description": "Generate SSH keypairs (Ed25519, ECDSA, RSA) entirely in-browser using the WebCrypto API.",
  "author": "chrome-ssh-keygen contributors",
  "homepage_url": "https://github.com/anthropics/chrome-ssh-keygen",
  "permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Generate SSH Key",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
